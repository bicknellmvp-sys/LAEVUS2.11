# ====================================================================
# LAEVUS SANCTUARY - ENVIRONMENT VARIABLES TEMPLATE
# ====================================================================
# DO NOT COMMIT SENSITIVE VALUES TO GITHUB.
#
# FOR RENDER.COM DEPLOYMENT:
# Add GEMINI_API_KEY directly in your Render Dashboard:
# Service Settings -> Environment -> Add Environment Variable -> GEMINI_API_KEY
#
# FOR LOCAL DEVELOPMENT:
# Copy this file to .env and insert your personal Gemini API key:
# cp .env.example .env
# ====================================================================

# Google Gemini API Key (Server-side only, never exposed to client)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (Render sets this dynamically; defaults to 3000 locally)
PORT=3000

# Node Environment
NODE_ENV=production
